{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appmmm",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2ff703be-c2ff-4922-9566-7fe0b62133a1","database_name": "web-appmmm" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "86edfbae668c4d3fbaf16fd462c1ff20" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
